{
	"name": "stoic-reader",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"parse": "node scripts/parse-gutenberg.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"preview:cf": "npm run build && wrangler dev",
		"deploy": "npm run build && npm run deploy:cf",
		"deploy:cf": "wrangler deploy"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^13.5.0",
		"@astrojs/sitemap": "3.7.2",
		"astro": "^6.3.1",
		"lit": "^3.3.2"
	},
	"devDependencies": {
		"@types/node": "latest",
		"pagefind": "^1.5.2",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "^0.14.1",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"wrangler": "^4.90.0"
	}
}
