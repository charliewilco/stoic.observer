---
import { authorPages, works, type AuthorSlug } from "../lib/works";
const currentPath = Astro.url.pathname;

const navItems = [
	...authorPages.map((author) => ({
		label: author.name,
		href: `/${author.slug}/`,
		kind: "author" as const,
		author: author.slug,
	})),
	{ label: "Search", href: "/search/", kind: "search" as const },
];

function isCurrentItem(item: (typeof navItems)[number]): boolean {
	if (item.kind === "search") {
		return currentPath.startsWith("/search/");
	}

	return currentPath.startsWith(item.href) || isAuthorWorkPath(item.author, currentPath);
}

function isAuthorWorkPath(author: AuthorSlug, pathname: string): boolean {
	if (author === "marcus" && pathname.startsWith("/book/")) {
		return true;
	}

	return works
		.filter((work) => work.authorSlug === author)
		.some((work) => pathname === `/${work.slug}/` || pathname.startsWith(`/${work.slug}/`));
}
---

<aside class="site-sidebar">
	<a class="site-title" href="/">stoic.observer</a>
	<nav aria-label="Primary navigation" class="site-nav">
		{
			navItems.map((item) => (
				<a href={item.href} aria-current={isCurrentItem(item) ? "page" : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>
</aside>

<style>
	.site-nav {
		display: grid;
		gap: 0.2rem;
	}

	.site-nav a {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.34rem 0;
		color: var(--color-subtle);
		font-size: 0.9rem;
		font-weight: 600;
		font-stretch: extra-condensed;
		line-height: 1.35;
		text-decoration: none;
	}

	.site-nav a::before {
		content: "";
		flex: 0 0 auto;
		width: 0.72rem;
		height: 0.72rem;
		border: 1.5px solid currentColor;
		opacity: 0.7;
	}

	.site-nav a[aria-current="page"]::before {
		background: currentColor;
		opacity: 1;
	}

	.site-nav a:hover,
	.site-nav a[aria-current="page"] {
		color: var(--color-focus);
	}

	@media (max-width: 860px) {
		.site-nav {
			display: flex;
			flex-wrap: wrap;
			gap: 0.45rem 0.95rem;
		}

		.site-nav a {
			flex: 0 0 auto;
			padding: 0;
			font-size: 0.78rem;
		}

		.site-nav a::before {
			display: none;
		}
	}
</style>
