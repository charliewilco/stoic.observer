---
import Base from "../layouts/Base.astro";

const query = Astro.url.searchParams.get("q") ?? "";
const title = query ? `Search for "${query}" | Meditations Reader` : "Search | Meditations Reader";
---

<Base title={title} description="Search Marcus Aurelius' Meditations by book and section.">
	<header class="library-header">
		<p class="page-kicker">Search</p>
		<h1>Search</h1>
		<p>Search the Stoic canon by word or phrase.</p>
	</header>
</Base>
