---
import LibraryWorkRow from "../components/LibraryWorkRow.astro";
import MeditationsSearch from "../components/MeditationsSearch.astro";
import Base from "../layouts/Base.astro";
import { works } from "../lib/works";

const summaries: Record<string, string> = {
	enchiridion: "A compact manual of Stoic practice: desire, aversion, judgment, and freedom.",
	letters: "Moral letters on friendship, time, fear, wealth, grief, and learning how to die.",
	"on-the-shortness-of-life": "Seneca's argument that life is long enough when attention is not wasted.",
	"on-tranquility-of-mind": "A practical essay on steadiness, restlessness, ambition, and inner composure.",
	"on-providence": "A defense of hardship as training rather than evidence of abandonment.",
	"on-the-happy-life": "A direct treatment of virtue, pleasure, wealth, and what happiness can actually mean.",
	"on-leisure": "Seneca on withdrawal, public life, usefulness, and philosophical work.",
	"on-the-firmness-of-the-wise-man": "A study of insult, injury, dignity, and the resilient mind.",
	"consolation-to-helvia": "A letter on exile, loss, memory, and the portability of the philosophical life.",
	"consolation-to-marcia": "A consolation on grief, bereavement, endurance, and the limits of sorrow.",
	"consolation-to-polybius": "A politically complicated consolation on grief, service, and fortune.",
	lectures: "Musonius on practice, education, food, marriage, hardship, and everyday discipline.",
	"hierocles/elements-of-ethics": "Fragments on self-perception, kinship, obligation, and ethical circles.",
	discourses: "Epictetus in full voice: training attention, judgment, impulse, and desire.",
	"on-anger": "Seneca's extended diagnosis of anger and how to dismantle it before it rules.",
	"on-mercy": "A political essay on power, restraint, judgment, and humane rule.",
	"on-benefits": "A long treatment of giving, gratitude, obligation, generosity, and social debt.",
};

const libraryWorks = [
	{
		title: "Meditations",
		author: "Marcus Aurelius",
		href: "/book/1/",
		meta: "12 books",
		summary: "Private notes on attention, conduct, mortality, and living under pressure.",
	},
	...works.map((work) => ({
		title: work.title,
		author: work.author,
		href: `/${work.slug}/`,
		meta:
			work.kind === "flat"
				? work.expectedCount
					? `${work.expectedCount} ${work.itemPlural.toLowerCase()}`
					: work.itemPlural
				: `${work.bookCount} books`,
		summary: summaries[work.slug],
	})),
];
---

<Base title="stoic.observer" description="Read and search public-domain translations of practical Stoic texts.">
	<MeditationsSearch slot="header-search" />

	<header class="library-header">
		<p class="page-kicker">Library</p>
		<h1>All Works</h1>
		<p>Public-domain practical Stoic texts arranged for quiet reading and fast search.</p>
	</header>

	<nav aria-label="Stoic works" class="library-list">
		{libraryWorks.map((work) => <LibraryWorkRow {...work} />)}
	</nav>
</Base>
